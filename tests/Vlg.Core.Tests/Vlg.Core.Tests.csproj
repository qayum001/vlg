<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET 10 SDK dotnet test runs Microsoft.Testing.Platform only (opt-in in /global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vlg.Core\Vlg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\game\data\stress.json" Link="data\stress.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\game\data\run.json" Link="data\run.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\game\data\heroes\lowkey.json" Link="data\heroes\lowkey.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\game\data\items.json" Link="data\items.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
