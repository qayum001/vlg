; Engine configuration file.
; Hand-edited: keep keys sorted by section like the editor writes them.

config_version=5

[application]

config/name="vlg"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
run/max_fps=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900

[dotnet]

project/assembly_name="Vlg"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
