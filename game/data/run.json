// Level run tuning (first gameplay slice). Parsed strictly by Vlg.Core RunConfig: unknown or missing keys throw.
// Distances in meters, times in seconds, angles in radians. All values are placeholders (design/domain.md).
{
  "sim": {
    "maxStepSec": 0.05,
    "enemyCapacity": 4096,
    "projectileCapacity": 4096,
    "gemCapacity": 4096,
    "ringCapacity": 256,
    "zoneCapacity": 512,
    "gridDim": 64,
    "gridCellSize": 2.0,
    "projectileRadius": 0.25,
    "workerThreads": -1,
    "parallelMinCount": 2048
  },
  // Angle below the horizon, distance to the hero, vertical FOV. Spawning follows the view.
  "camera": { "tiltDeg": 40, "distance": 28, "fovDeg": 45, "followRate": 10, "shadowDistance": 80 },
  // Body shared by every hero. Per-hero stats, beat and skills: data/heroes/<id>.json.
  "hero": { "radius": 0.5, "contactMargin": 0.3 },
  "walker": {
    "hp": 8,
    "speed": 3.0,
    "radius": 0.45,
    "contactDps": 5,
    "xp": 1,
    "separationRadius": 1.0,
    "separationStrength": 4.0,
    "maxNeighbors": 12,
    "headingTurnRate": 8.0,
    "animRate": 1.6,
    "hitFlashDecay": 6.0,
    // Knockback/pull decay, 1/s: a push of v m/s carries the walker about v / pushDecay m.
    "pushDecay": 6.0
  },
  // Walkers spawn at view edge + viewMargin + [0, band) in a random direction (~16 m behind the hero, ~40-60 m ahead
  // at 16:9). despawnRadius must exceed the farthest visible point at 21:9 (validated).
  "spawn": { "viewMargin": 6, "band": 6, "despawnRadius": 80 },
  // Gems farther than despawnRadius from the hero vanish (XP lost).
  "pickups": { "magnetSpeed": 16, "collectRadius": 0.6, "despawnRadius": 80 },
  "leveling": {
    "xpBase": 5,
    "xpPerLevel": 5,
    "levelDivisor": 3,
    "maxSkillLevel": 10,
    "maxedBonusDamage": 0.02,
    // Skill levels where the player picks a branch (domain.md).
    "branchLevels": [5, 10],
    // Hero levels where the ultimate unlocks and upgrades (domain.md).
    "ultimateLevels": [10, 20, 30]
  },
  "loopScaling": { "hpPerLoop": 0.3, "damagePerLoop": 0.2, "spawnPerLoop": 0.25 },
  // One loop. Chest and Shop wait for the player (placeholder screens until items exist).
  "stages": [
    { "kind": "mobs", "durationSec": 120, "spawnPerSec": 1.2, "maxAlive": 120 },
    { "kind": "horde", "durationSec": 60, "spawnPerSec": 6, "maxAlive": 300 },
    { "kind": "chest" },
    { "kind": "mobs", "durationSec": 120, "spawnPerSec": 1.2, "maxAlive": 120 },
    { "kind": "shop" }
  ]
}
